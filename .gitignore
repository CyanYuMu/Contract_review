# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work
go.work.sum

# Dependency directories
vendor/

# Build output
bin/
dist/
build/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Frontend (Next.js + pnpm)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/.eslintcache
frontend/pnpm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/npm-debug.log*

# Logs
*.log
logs/

# Uploads (optional, uncomment if needed)
# uploads/

# Config with secrets - DO NOT commit
app/config/config.yaml
app/config/*.yaml
app/config/*.yml
app/config/*.json
!app/config/*.example.yaml
!app/config/*.example.yml
!app/config/*.example.json

# Docker compose files (may contain secrets)
docker-compose*.yaml
docker-compose*.yml
!docker-compose*.example.yaml
!docker-compose*.example.yml

# Contract documents
*.docx
*.doc
*.pdf

# Uploads directory (contains user uploaded contracts)
uploads/

# Strange directories
~/

# Python cache (from reference files)
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python/

# Temporary files
tmp/
temp/
*.tmp

# Database files (if using local db)
*.db
*.sqlite
/frontend/tsconfig.tsbuildinfo
