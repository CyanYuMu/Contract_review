	"gitlab.outer.staruniongame.com/aiart/seago/utils/trace"
)

var version = sarama.V2_8_0_0

type Config struct {
	// cfg.Producer.Timeout 发送消息超时时间, 单位秒
	Timeout int
	// 自定义分区方式, 为空默认使用 sarama.NewHashPartitioner
	Partitioner sarama.PartitionerConstructor
	// 消息等级 1. 允许消息出现丢失, leader确认收到消息即可, 性能较高 2. 不允许消息丢失, 所有broker均确认收到消息
	Level int
	// [可选] 用户名
	User string
	// [可选] 密码
	Password string
	// 同步所有主题的metadata信息, 默认为 false
	SyncFullMetadata bool
	// 获取metadata信息最大重试次数, 默认3次
	MetadataMaxRetryTimes int
	// 获取metadata超时时间, 单位秒, 默认30s
	MetadataTimeout int
	// 元数据信息刷新间隔, 单位秒, 默认10分钟
	MetadataRefreshIntervalSecond int
	// 最大重新投递次数
	ProducerMaxRetryTimes int
	// 投递超时时间, 单位秒
	ProducerTimeout int

	//Dial网络时间配置, 单位秒
	//connection 超时时间, 默认30s
	DialTimeout int
	//Read 时间, 单位秒, 默认30s
	ReadTimeout int
	//Write 时间, 单位秒, 默认30s
	WriteTimeout int
}

func configParser(cnf *Config) *sarama.Config {
	cfg := sarama.NewConfig()

	cfg.Version = version
	// 最大重试次数
	cfg.Producer.Retry.Max = 3
	if cnf.ProducerMaxRetryTimes == -1 {
		cfg.Producer.Retry.Max = 0
	} else if cnf.ProducerMaxRetryTimes > 0 {
		cfg.Producer.Retry.Max = cnf.ProducerMaxRetryTimes
	}
	cfg.Producer.Timeout = time.Duration(cnf.Timeout) * time.Second
	if cnf.ProducerTimeout > 0 {
		cfg.Producer.Timeout = time.Duration(cnf.ProducerTimeout) * time.Second
	}
	// 分区方式
	if cnf.Partitioner == nil {
		// 默认值
		cnf.Partitioner = sarama.NewHashPartitioner
	}
	if cnf.MetadataTimeout > 0 {
		cfg.Metadata.Timeout = time.Duration(cnf.MetadataTimeout) * time.Second
	} else {
		cfg.Metadata.Timeout = time.Second * 30
	}
	if cnf.MetadataRefreshIntervalSecond > 0 {
		cfg.Metadata.RefreshFrequency = time.Duration(cnf.MetadataRefreshIntervalSecond) * time.Second
	}
	if cnf.MetadataMaxRetryTimes == -1 {
		cfg.Metadata.Retry.Max = 0
	} else if cnf.MetadataMaxRetryTimes > 0 {
		cfg.Metadata.Retry.Max = cnf.MetadataMaxRetryTimes
	}

	cfg.Metadata.Full = cnf.SyncFullMetadata

	cfg.Producer.Partitioner = cnf.Partitioner
	// 异步投递, 返回成功和失败
	cfg.Producer.Return.Successes = true
	cfg.Producer.Return.Errors = true
	// 失败重试间隔
	cfg.Producer.Retry.Backoff = time.Second
	if cnf.Level == 2 {
		cfg.Producer.RequiredAcks = sarama.WaitForAll
	} else if cnf.Level == 1 {
		cfg.Producer.RequiredAcks = sarama.WaitForLocal
	} else {
		cfg.Producer.RequiredAcks = sarama.NoResponse
	}
	cfg.Net.SASL.User = cnf.User
	cfg.Net.SASL.Password = cnf.Password
	//Dial网络时间配置
	if cnf.DialTimeout > 0 {
		cfg.Net.DialTimeout = time.Duration(cnf.DialTimeout) * time.Second
	} else {
		cfg.Net.DialTimeout = time.Second * 30
	}
	if cnf.ReadTimeout > 0 {
		cfg.Net.ReadTimeout = time.Duration(cnf.ReadTimeout) * time.Second
	} else {
		cfg.Net.ReadTimeout = time.Second * 30
	}
	if cnf.WriteTimeout > 0 {
		cfg.Net.WriteTimeout = time.Duration(cnf.WriteTimeout) * time.Second
	} else {
		cfg.Net.WriteTimeout = time.Second * 30
	}
	return cfg
}

func New(brokers []string, conf *Config) *Kafka {
	sarama.Logger = &Logger{}
	cfg := configParser(conf)
	return &Kafka{
		config: cfg,
		addrs:  brokers,
	}
}

type Producer struct {
	syncProducer  sarama.SyncProducer
	asyncProducer sarama.AsyncProducer
	// 异步队列使用
	input   chan<- *sarama.ProducerMessage
	isAsync bool
	cli     sarama.Client
}

/*ParserTrace
* @Description: 解析trace信息
* @param msg
* @return traceId
* @return spanId
 */
func ParserTrace(in interface{}) (traceId, spanId string) {
	if msg, ok := in.(*sarama.ProducerMessage); ok {
		if msg.Headers == nil {
			return
		}
		for _, v := range msg.Headers {
			if string(v.Key) == enum.CtxRequestId {
				traceId = string(v.Value)
			} else if string(v.Key) == enum.SpanId {
				spanId = string(v.Value)
			}
		}
	} else if msg1, ok1 := in.(*sarama.ConsumerMessage); ok1 {
		if msg1.Headers == nil {
			return
		}
		for _, v := range msg1.Headers {
			if string(v.Key) == enum.CtxRequestId {
				traceId = string(v.Value)
			} else if string(v.Key) == enum.SpanId {
				spanId = string(v.Value)
			}
		}
	}

	return
}

func msgFilter(ctx context.Context, msg *sarama.ProducerMessage) {
	traceId, spanId := trace.ParseFromContext(ctx)
	// 检测header中是否存在链路信息, 没有则进行补充
	var hasTrace bool
	var hasSpan bool

	for i, _ := range msg.Headers {
		if string(msg.Headers[i].Key) == enum.CtxRequestId {
			hasTrace = true
		} else if string(msg.Headers[i].Key) == enum.SpanId {
			hasSpan = true
		}
	}
	if !hasTrace {
		msg.Headers = append(msg.Headers, sarama.RecordHeader{
			Key:   []byte(enum.CtxRequestId),
			Value: []byte(traceId),
		})
	}
	if !hasSpan {
		msg.Headers = append(msg.Headers, sarama.RecordHeader{
			Key:   []byte(enum.SpanId),
			Value: []byte(spanId),
		})
	}
}

func (s *Producer) SendV2(ctx context.Context, msg *sarama.ProducerMessage) (partition int32, offset int64, err error) {
	msgFilter(ctx, msg)
	if s.isAsync {
		s.input <- msg
		return
	} else {
		return s.syncProducer.SendMessage(msg)
	}
}

func (s *Producer) BatchSendV2(ctx context.Context, msgList []*sarama.ProducerMessage) error {
	for i, _ := range msgList {
		msgFilter(ctx, msgList[i])
	}

	if s.isAsync {
		for i, _ := range msgList {
			s.input <- msgList[i]
		}

		return nil
	} else {
		return s.syncProducer.SendMessages(msgList)
	}
}

func (s *Producer) Send(msg *sarama.ProducerMessage) (partition int32, offset int64, err error) {
	if s.isAsync {
		s.input <- msg
		return
	} else {
		return s.syncProducer.SendMessage(msg)
	}
}

func (s *Producer) BatchSend(msgList []*sarama.ProducerMessage) error {
	if s.isAsync {
		for i := range msgList {
			s.input <- msgList[i]
		}

		return nil
	} else {
		return s.syncProducer.SendMessages(msgList)
	}
}

func (s *Producer) Get() (sync sarama.SyncProducer, async sarama.AsyncProducer) {
	return s.syncProducer, s.asyncProducer
}

func (s *Producer) GetClient() (cli sarama.Client) {
	return s.cli
}

type BalanceStrategy string

const (
	BalanceStrategySticky     = "sticky"
	BalanceStrategyRoundrobin = "roundrobin"
	BalanceStrategyRange      = "range"
)

type ConsumerConfig struct {
	// 非必填, 是否开启自动提交
	AutoCommit bool
	// 非必填, 默认1秒, 自动提交周期, 在AutoCommit为true时有效
	AutoCommitInterval time.Duration
	// 非必填, 支持 sarama.OffsetOldest(默认), sarama.OffsetNewest
	Initial int64
	// 必填, 消费者id
	GroupId string
	// 非必填 重平衡策略, 支持 sticky(默认) -> 尽可能与原来的消费者绑在一起,  roundrobin -> 轮询, range -> 范围分区
	BalanceStrategy BalanceStrategy
}

type Kafka struct {
	addrs      []string
	config     *sarama.Config
	client     sarama.Client
	clientOnce sync.Once
	User       string
	password   string
}

// 手动设置kafka版本
func (k *Kafka) SetVersion(v sarama.KafkaVersion) {
	k.config.Version = v
}

func (k *Kafka) GetAdmin() (sarama.ClusterAdmin, error) {
	cnf := *k.config
	cnf.Metadata.Full = true
	admin, err := sarama.NewClusterAdmin(k.addrs, &cnf)
	return admin, err
}

func (k *Kafka) CreateTopic(name string, numPartition int32) error {
	adm, err := k.GetAdmin()
	if err != nil {
		return err
	}

	defer adm.Close()

	err = adm.CreateTopic(name, &sarama.TopicDetail{
		NumPartitions: numPartition,
	}, false)

	return err
}

func (k *Kafka) ListTopic() (topics map[string]sarama.TopicDetail, err error) {
	adm, err := k.GetAdmin()
	if err != nil {
		return
	}

	topics, err = adm.ListTopics()

	return
}

func (k *Kafka) DescribeTopic(name string) (detail *sarama.TopicMetadata, err error) {
	adm, err := k.GetAdmin()
	if err != nil {
		return nil, err
	}

	topics, err := adm.DescribeTopics([]string{name})
	if err != nil {
		return nil, err
	}

	if topics == nil {
		return nil, errors.New("topic not found")
	}

	return topics[0], nil
}

func (k *Kafka) GetClient() (cli sarama.Client, err error) {
	if k.client == nil {
		k.clientOnce.Do(func() {
			conf := k.config
			cli, err = sarama.NewClient(k.addrs, conf)
			k.client = cli
		})
	}

	return k.client, nil
}

type TopicConf struct {
	// * topic名称
	Name string
	// ? 分区数量, 默认8
	NumOfPartition int
	// ? 副本数量, 默认1
	NumOfReplication int
	// ? 保留的时长, 单位秒, 默认2天
	RetentionSec int64
}

var ErrTopicAlreadyExist = errors.New("topic already exist")

func (k *Kafka) NewTopic(cnf TopicConf) error {
	adm, err := k.GetAdmin()
	if err != nil {
		return err
	}

	if cnf.NumOfPartition < 1 {
		cnf.NumOfPartition = 8
	}

	if cnf.NumOfReplication < 1 {
		cnf.NumOfReplication = 1
	}

	if cnf.RetentionSec < 1 {
		cnf.RetentionSec = 2 * 24 * 60 * 60
	}

	retentionMs := cnf.RetentionSec * 1000

	defer adm.Close()

	metadata, err := adm.DescribeTopics([]string{cnf.Name})
	if err != nil {
		return err
	}

	if metadata[0].Err == sarama.ErrUnknownTopicOrPartition {
		// 创建topic
		retentionMsStr := cast.ToString(retentionMs)
		err = adm.CreateTopic(cnf.Name, &sarama.TopicDetail{
			NumPartitions:     int32(cnf.NumOfPartition),
			ReplicationFactor: int16(cnf.NumOfReplication),
			ConfigEntries: map[string]*string{
				"retention.ms": &retentionMsStr,
			},
		}, false)

		return err
	} else {
		if metadata[0].Err != sarama.ErrNoError {
			return ErrTopicAlreadyExist
		} else {
			return metadata[0].Err
		}
	}
}

func (k *Kafka) DelTopic(name string) error {
	adm, err := k.GetAdmin()
	if err != nil {
		return err
	}
	err = adm.DeleteTopic(name)

	if err != nil {
		// 针对不存在的情况也认为删除成功
		if strings.Contains(err.Error(), "does not exist") {
			return nil
		}
	}

	return err
}

func (k *Kafka) NewProducer(conf ...Config) (*Producer, error) {
	cfg := k.config
	if conf != nil {
		cfg = configParser(&conf[0])
	}
	//cfg.Admin.Retry.Max = 1
	//cfg.Admin.Retry.Backoff = 1
	//cfg.Producer.Retry.Max = 1
	//cfg.Metadata.Retry.Max = 1
	//cfg.Metadata.Timeout = time.Second * 30
	//cfg.Metadata.Full = false
	//cfg.Net.DialTimeout = time.Second * 2

	cli, err := sarama.NewClient(k.addrs, cfg)
	if err != nil {
		return nil, err
	}

	producer, err := sarama.NewSyncProducerFromClient(cli)
	if err != nil {
		return nil, err
	}

	return &Producer{
		isAsync:      false,
		syncProducer: producer,
		cli:          cli,
	}, err
}

type AsyncHandlerConfig struct {
	Success func(msg sarama.ProducerMessage)
	Error   func(msg sarama.ProducerError)
}

func (k *Kafka) NewAsyncProducer(handler *AsyncHandlerConfig) (*Producer, error) {
	producer, err := sarama.NewAsyncProducer(k.addrs, k.config)
	if err != nil {
		return nil, err
	}

	if handler != nil {
		if handler.Success != nil {
			go func() {
				for message := range producer.Successes() {
					handler.Success(*message)
				}
			}()
		}

		if handler.Error != nil {
			go func() {
				for msg := range producer.Errors() {
					handler.Error(*msg)
				}
			}()
		}
	}
	producer.Input()
	return &Producer{
		isAsync:       true,
		asyncProducer: producer,
		input:         producer.Input(),
	}, nil
}

func (k *Kafka) NewConsumerGroup(consumeConf ConsumerConfig) (g *Consumer, err error) {
	var strategy sarama.BalanceStrategy
	var cnf = sarama.NewConfig()
	switch consumeConf.BalanceStrategy {
	case BalanceStrategyRoundrobin:
		strategy = sarama.BalanceStrategyRoundRobin
	case BalanceStrategyRange:
		strategy = sarama.BalanceStrategyRange
	default:
		strategy = sarama.BalanceStrategySticky
	}

	cnf.Consumer.Group.Rebalance.Strategy = strategy
	cnf.Consumer.Offsets.AutoCommit.Enable = consumeConf.AutoCommit
	var interval = consumeConf.AutoCommitInterval
	if interval == 0 {
		interval = time.Second * 5
	}
	cnf.Consumer.Offsets.AutoCommit.Interval = interval
	if consumeConf.Initial == 0 {
		consumeConf.Initial = sarama.OffsetOldest
	}
	cnf.Consumer.Offsets.Initial = consumeConf.Initial

	//k.consumerGroupId = consumeConf.GroupId
	su_logger.Info(nil, "NewConsumerGroup GroupId:"+consumeConf.GroupId)

	return k.TryANewConsumerGroup(consumeConf.GroupId, cnf)
}

func (k *Kafka) TryANewConsumerGroup(groupId string, conf *sarama.Config) (g *Consumer, err error) {
	cg, err := sarama.NewConsumerGroup(k.addrs, groupId, conf)
	if err != nil {
		return nil, err
	}

	if err != nil {
		return nil, err
	}

	return &Consumer{g: cg, parent: k, config: conf, groupId: groupId, recreateCGCh: make(chan struct{}, 1), quit: make(chan struct{}, 1)}, err
}

// ConsumerGroupHandler
type Consumer struct {
	g               sarama.ConsumerGroup
	parent          *Kafka
	quit            chan struct{}
	recreateCGCh    chan struct{}
	config          *sarama.Config
	consumerGroupId string
	groupId         string
}

func (c *Consumer) GracefulShutdown() {
	if c.g != nil {
		c.g.Close()
	}
	// 当前进程退出
	c.quit <- struct{}{}
}

// ConsumeHook
// @Description: 消费过程中的钩子
type ConsumeHook struct {
	// 消费组退出前
	BeforeQuit func()
	// 消费者发生异常情况时调用
	Exception func(err error)
	// 消费组发生重平衡时调用
	BeforeRebalance func()
}

// Consume
// @description 如果想自定义offset, 可在Setup()进行指定, 参考 session.ResetOffset("t2p4", 0, 13, "")
// Setup 会在一个新会话开始之前运行，且也在 ConsumerClaim 接口之前运行。调用流程为 Consume —> newSession —> newConsumerGroupSession —> handler.Setup
// - topic: 多个topic时, 多个topic使用","隔开
func (c *Consumer) Consume(ctx context.Context, topic string, handler sarama.ConsumerGroupHandler, hook ...*ConsumeHook) error {
	for {
		select {
		case <-c.quit:
			if hook != nil && hook[0].BeforeQuit != nil {
				hook[0].BeforeQuit()
			}

			return error2.NewSUError(500502, "closed by human  topic:"+topic)
		case <-c.recreateCGCh:
			// 这种情况需要重新建立consumerGroup
			su_logger.Error(nil, nil, "kafka consumer error try to recreate consumer group: "+topic)
			if c.g != nil {
				_ = c.g.Close()
			}
			// 这里的休眠时间长一点, 让同组的其它服务也能收到err错误
			var cg *Consumer
			var err error
			var retryTimes = 1
			for {
				dur := time.Second * 5 * time.Duration(retryTimes)
				if dur >= time.Minute {
					dur = time.Minute
				}
				time.Sleep(dur)
				cg, err = c.parent.TryANewConsumerGroup(c.groupId, c.config)
				if err != nil {
					su_logger.Error(nil, err, "kafka consumer error failed to recreate consumer group:"+topic, su_logger.E().Int("retrying times:", retryTimes))
					retryTimes += 1
				} else {
					break
				}
			}

			//return group.Consume(ctx, topic, handler)
			c.g = cg.g
			c.parent = cg.parent
			c.groupId = cg.groupId
			c.config = cg.config
			c.quit = cg.quit
			c.recreateCGCh = cg.recreateCGCh

		default:
			topics := strings.Split(topic, ",")
			su_logger.Debug(nil, "start consume", su_logger.E().Any("topic", topics))
			func() {
				defer func() {
					if err := recover(); err != nil {
						// 重开 group
						c.recreateCGCh <- struct{}{}
					}
				}()
				err := c.g.Consume(ctx, topics, handler)
				if err != nil {
					if hook != nil && hook[0].Exception != nil {
						hook[0].Exception(err)
					}

					c.recreateCGCh <- struct{}{}
				} else {
					if hook != nil && hook[0].BeforeRebalance != nil {
						hook[0].BeforeRebalance()
					}
					su_logger.Debug(nil, "kafka consumer rebalanced topic:"+topic)
					// 休眠一下再重新建立连接
					time.Sleep(time.Second * 2)
				}
			}()
		}
	}
}

func (c *Consumer) Get() sarama.ConsumerGroup {
	return c.g
}
