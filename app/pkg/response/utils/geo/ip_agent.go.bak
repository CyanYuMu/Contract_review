package geo

import (
	"context"
	"sync"

	"gitlab.outer.staruniongame.com/aiart/seago/utils/su_logger"
	ip_agent "gitlab.outer.staruniongame.com/share/ip-agent"
)

type IpAgent struct {
	cli  *ip_agent.IPAgentClient
	once sync.Once
}

func (i *IpAgent) getClient() *ip_agent.IPAgentClient {
	if i.cli != nil {
		return i.cli
	}
	i.once.Do(func() {
		var err error
		i.cli, err = ip_agent.New(ip_agent.OptWithEnv(ip_agent.Master), ip_agent.OptWithDbPath("/tmp/GeoLite2-City.mmdb"), ip_agent.OptWithUseLocalDbFirst(true), ip_agent.OptWithDisableCache(true))
		if err != nil {
			su_logger.Error(context.Background(), err, "ip_agent.New")
			panic(err)
		}
	})
	return i.cli
}

func (i *IpAgent) Ip2Region(ctx context.Context, ip string) (Region, error) {
	region, err := i.getClient().Ip2Region(ctx, ip)
	if err != nil {
		su_logger.Error(ctx, err, "ip_agent.Ip2Region ip:"+ip)
		return Region{}, err
	}
	return Region{
		CountryCode: region.CountryCode,
		Province:    region.Province,
		City:        region.City,
	}, nil
}
